{
  "name": "@machine202502/dsh-restart",
  "version": "0.2.3",
  "type": "module",
  "description": "Restart DeepSeek Harness from the sidebar or from an agent tool, optionally continuing the same session afterwards.",
  "license": "MIT",
  "author": "machine202502",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.ru.md",
    "src/*.js",
    "src/*.mjs",
    "src/*.py",
    "src/*.ps1",
    "src/*.sh"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/machine202502/dsh-restart.git"
  },
  "homepage": "https://github.com/machine202502/dsh-restart#readme",
  "bugs": {
    "url": "https://github.com/machine202502/dsh-restart/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin"
  ]
}
